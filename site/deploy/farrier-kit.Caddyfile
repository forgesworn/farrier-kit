# farrier-kit.forgesworn.dev — the bench: a static page plus one bundled script,
# served from /opt/farrier-kit on the shared "routing" box (95.217.39.110).
#
# Install: additive conf.d drop-in (imported by the main Caddyfile); never
# touches another tenant's dir, unit, or vhost. Validate, then reload:
#   sudo caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
#   sudo systemctl reload caddy
#
# Auto-TLS: the A record is grey-cloud (DNS-only), so Caddy issues and renews
# the Let's Encrypt certificate itself.
farrier-kit.forgesworn.dev {
	root * /opt/farrier-kit
	encode zstd gzip
	file_server

	# Privacy: no access logs. The colophon promises no analytics, so the host
	# keeps no request logs either (same stance as heartwood and cambium).
	log {
		output discard
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		X-Frame-Options DENY
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		# Unlike heartwood and cambium this page is not script-free: the bench
		# is the library itself, bundled. So script-src 'self' rather than
		# default-src 'none' alone. Everything else stays shut, and
		# connect-src inherits 'none' from the default, which is what makes
		# the page's claim true rather than merely promised: it cannot reach
		# the network even if a future edit tried to.
		Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
		# Nothing is content-hashed; revalidate so a deploy shows on the next
		# load (file_server's ETag makes an unchanged check a cheap 304).
		?Cache-Control "no-cache"
	}

	# The fonts are the heaviest assets and effectively never change; if one
	# ever does, it gets a new filename rather than a cache bust.
	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"
}
